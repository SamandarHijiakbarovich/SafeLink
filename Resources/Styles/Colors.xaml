<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═══════════════════════════════════════════
         SafeLink Design Tokens
         Qizil FAQAT SOS/xavf elementlari uchun!
    ═══════════════════════════════════════════ -->

    <!-- Brand Navy (ishonch) -->
    <Color x:Key="Navy">#0A2540</Color>
    <Color x:Key="Navy2">#13325F</Color>
    <Color x:Key="Navy3">#1F4480</Color>

    <!-- Fon ranglari -->
    <Color x:Key="BgMain">#F5F7FB</Color>
    <Color x:Key="Card">#FFFFFF</Color>
    <Color x:Key="CardAlt">#F0F3F9</Color>

    <!-- Matn ranglari -->
    <Color x:Key="Ink">#0A2540</Color>
    <Color x:Key="Ink2">#334155</Color>
    <Color x:Key="Muted">#64748B</Color>
    <Color x:Key="Faint">#94A3B8</Color>

    <!-- Chegara ranglari -->
    <Color x:Key="Line">#E5E9F0</Color>
    <Color x:Key="Line2">#CBD5E1</Color>

    <!-- XAVF rangi — FAQAT SOS uchun -->
    <Color x:Key="Red">#E11D48</Color>
    <Color x:Key="RedDeep">#9F1239</Color>
    <Color x:Key="RedSoft">#FEE2E7</Color>

    <!-- Muvaffaqiyat -->
    <Color x:Key="Green">#16A34A</Color>
    <Color x:Key="GreenSoft">#DCFCE7</Color>

    <!-- Ogohlantirish -->
    <Color x:Key="Amber">#D97706</Color>

    <!-- Umumiy -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Transparent">Transparent</Color>

    <!-- ═══════════════════════════════════════════════════════
         Styles.xaml uchun kerakli standart ranglar
         (o'chirmaslik — MAUI tizimi ishlatadi)
    ═══════════════════════════════════════════════════════ -->
    <Color x:Key="Primary">#0A2540</Color>
    <Color x:Key="PrimaryDark">#1F4480</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#E11D48</Color>
    <Color x:Key="SecondaryDarkText">#FEE2E7</Color>
    <Color x:Key="Tertiary">#16A34A</Color>

    <Color x:Key="MidnightBlue">#0A2540</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>
    <Color x:Key="Magenta">#E11D48</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Brushlar -->
    <SolidColorBrush x:Key="NavyBrush"     Color="{StaticResource Navy}"/>
    <SolidColorBrush x:Key="Navy2Brush"    Color="{StaticResource Navy2}"/>
    <SolidColorBrush x:Key="BgMainBrush"   Color="{StaticResource BgMain}"/>
    <SolidColorBrush x:Key="RedBrush"      Color="{StaticResource Red}"/>
    <SolidColorBrush x:Key="RedDeepBrush"  Color="{StaticResource RedDeep}"/>
    <SolidColorBrush x:Key="GreenBrush"    Color="{StaticResource Green}"/>
    <SolidColorBrush x:Key="CardBrush"     Color="{StaticResource Card}"/>
    <SolidColorBrush x:Key="WhiteBrush"    Color="{StaticResource White}"/>

</ResourceDictionary>
