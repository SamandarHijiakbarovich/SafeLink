<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SafeLink.Views"
    xmlns:onb="clr-namespace:SafeLink.Views.Onboarding"
    x:Class="SafeLink.AppShell"
    Shell.NavBarIsVisible="False">

    <Shell.Resources>
        <Style TargetType="Shell" ApplyToDerivedTypes="True">
            <Setter Property="Shell.TabBarBackgroundColor" Value="#FFFFFF"/>
            <Setter Property="Shell.TabBarForegroundColor" Value="#0A2540"/>
            <Setter Property="Shell.TabBarUnselectedColor" Value="#94A3B8"/>
            <Setter Property="Shell.TabBarTitleColor" Value="#0A2540"/>
        </Style>
    </Shell.Resources>

    <!-- ─── Onboarding oqimi (tab bar yo'q) ─────────────────── -->
    <ShellContent Route="welcome" Shell.NavBarIsVisible="False"
                  ContentTemplate="{DataTemplate onb:WelcomePage}"/>
    <ShellContent Route="phone"    Shell.NavBarIsVisible="False"
                  ContentTemplate="{DataTemplate onb:PhonePage}"/>
    <ShellContent Route="identity" Shell.NavBarIsVisible="False"
                  ContentTemplate="{DataTemplate onb:IdentityPage}"/>
    <ShellContent Route="order"    Shell.NavBarIsVisible="False"
                  ContentTemplate="{DataTemplate onb:OrderPage}"/>
    <ShellContent Route="contacts" Shell.NavBarIsVisible="False"
                  ContentTemplate="{DataTemplate onb:ContactsPage}"/>
    <ShellContent Route="complete" Shell.NavBarIsVisible="False"
                  ContentTemplate="{DataTemplate onb:CompletePage}"/>

    <!-- ─── Asosiy ilova (tab bar bilan) ─────────────────────── -->
    <TabBar Route="main">
        <ShellContent Title="Bosh sahifa" Route="home"
                      ContentTemplate="{DataTemplate views:HomePage}"/>
        <ShellContent Title="Tarix"       Route="history"
                      ContentTemplate="{DataTemplate views:HistoryPage}"/>
        <ShellContent Title="Profil"      Route="profile"
                      ContentTemplate="{DataTemplate views:ProfilePage}"/>
    </TabBar>

</Shell>
