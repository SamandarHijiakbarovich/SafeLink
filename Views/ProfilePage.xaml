<?xml version="1.0" encoding="utf-8" ?>
<!--
    PROFIL SAHIFASI
    ================
    Foydalanuvchi ma'lumotlari, brelok, kontaktlar, sozlamalar.
-->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SafeLink.ViewModels"
    xmlns:models="clr-namespace:SafeLink.Models"
    x:Class="SafeLink.Views.ProfilePage"
    x:DataType="vm:ProfileViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource BgMain}">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,100">

            <!-- ─── HEADER ───────────────────────────────────────── -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  Padding="24,56,24,0">
                <!-- Orqaga -->
                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource Card}"
                        StrokeThickness="1" Stroke="{StaticResource Line}"
                        StrokeShape="RoundRectangle 11"
                        WidthRequest="38" HeightRequest="38">
                    <Label Text="‹" FontSize="22" TextColor="{StaticResource Ink}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                </Border>

                <Label Grid.Column="1"
                       Text="Profil"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="{StaticResource Ink}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>

                <Border Grid.Column="2"
                        BackgroundColor="{StaticResource Card}"
                        StrokeThickness="1" Stroke="{StaticResource Line}"
                        StrokeShape="RoundRectangle 11"
                        WidthRequest="38" HeightRequest="38">
                    <Label Text="···" FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource Navy2}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowMenuCommand}"/>
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- ─── IDENTIFIKATSIYA KARTASI ──────────────────────── -->
            <Border Margin="16,20,16,0"
                    BackgroundColor="{StaticResource Navy}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    Padding="20">
                <VerticalStackLayout Spacing="0">
                    <!-- Avatar + Ism (bosilsa tahrirlanadi) -->
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditIdentityCommand}"/>
                        </Grid.GestureRecognizers>
                        <!-- Avatar doira -->
                        <Border Grid.Column="0"
                                WidthRequest="56" HeightRequest="56"
                                BackgroundColor="#475569"
                                StrokeThickness="2"
                                Stroke="#33FFFFFF"
                                StrokeShape="RoundRectangle 28"
                                Margin="0,0,14,0">
                            <Label Text="{Binding CurrentUser.Initials}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2"
                                            VerticalOptions="Center">
                            <Label Text="{Binding CurrentUser.FullName}"
                                   FontSize="18" FontAttributes="Bold"
                                   TextColor="White" CharacterSpacing="-0.2"/>
                            <Label Text="{Binding CurrentUser.NationalId, StringFormat='JShShIR {0}'}"
                                   FontSize="12.5" TextColor="#A6FFFFFF"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Himoya orderi -->
                    <Border BackgroundColor="#14FFFFFF"
                            StrokeThickness="1"
                            Stroke="#1EFFFFFF"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0"
                                    WidthRequest="28" HeightRequest="28"
                                    BackgroundColor="#3F16A34A"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Margin="0,0,10,0">
                                <Label Text="🛡" FontSize="14"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding CurrentUser.ProtectionOrderNumber, StringFormat='Himoya orderi № {0}', TargetNullValue='Himoya orderi kiritilmagan', FallbackValue='Himoya orderi kiritilmagan'}"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="White"/>
                                <Label Text="{Binding CurrentUser.ProtectionOrderExpiry, StringFormat='Amal qiladi · {0:dd-MMM yyyy}-gacha', TargetNullValue='Bosib kiriting', FallbackValue='Bosib kiriting'}"
                                       FontSize="11" TextColor="#99FFFFFF"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="›" FontSize="18"
                                   TextColor="#8CFFFFFF"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenProtectionOrderCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- ─── QURILMA KARTASI ───────────────────────────────── -->
            <Label Text="QURILMA"
                   FontSize="11" FontAttributes="Bold"
                   TextColor="{StaticResource Muted}"
                   CharacterSpacing="1.4"
                   Margin="40,18,24,8"/>

            <Border Margin="16,0"
                    BackgroundColor="{StaticResource Card}"
                    StrokeThickness="1" Stroke="{StaticResource Line}"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Brelok ikonka -->
                    <Border Grid.Column="0"
                            WidthRequest="56" HeightRequest="56"
                            BackgroundColor="{StaticResource Navy}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            Margin="0,0,14,0">
                        <Label Text="🔑" FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- Ma'lumotlar -->
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="{Binding Brelok.Name}"
                               FontSize="14.5" FontAttributes="Bold"
                               TextColor="{StaticResource Ink}"/>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="🔵" FontSize="12"/>
                            <Label Text="{Binding Brelok.ConnectionStatus}"
                                   FontSize="11.5"
                                   TextColor="{StaticResource Green}"/>
                            <Label Text="·" TextColor="{StaticResource Muted}"/>
                            <Label Text="Soat oldin sinov"
                                   FontSize="11.5"
                                   TextColor="{StaticResource Muted}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Batareya -->
                    <VerticalStackLayout Grid.Column="2"
                                         HorizontalOptions="End"
                                         Spacing="2">
                        <Label Text="🔋"
                               FontSize="14"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding Brelok.BatteryPercent, StringFormat='{0}%'}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource Muted}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- ─── ISHONCHLI KONTAKTLAR ──────────────────────────── -->
            <Label Text="{Binding Contacts.Count, StringFormat='ISHONCHLI KONTAKTLAR · {0} TA'}"
                   FontSize="11" FontAttributes="Bold"
                   TextColor="{StaticResource Muted}"
                   CharacterSpacing="1.4"
                   Margin="40,18,24,8"/>

            <Border Margin="16,0"
                    BackgroundColor="{StaticResource Card}"
                    StrokeThickness="1" Stroke="{StaticResource Line}"
                    StrokeShape="RoundRectangle 18">
                <VerticalStackLayout>
                    <!-- Kontaktlar ro'yxati -->
                    <CollectionView ItemsSource="{Binding Contacts}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:TrustedContact">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      Padding="16,12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenContactCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>
                                    <!-- Avatar -->
                                    <Border Grid.Column="0"
                                            WidthRequest="36" HeightRequest="36"
                                            BackgroundColor="{Binding AvatarColor}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 18"
                                            Margin="0,0,12,0">
                                        <Label Text="{Binding Initials}"
                                               FontSize="13" FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>

                                    <!-- Ism va munosabat -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Text="{Binding FullName}"
                                               FontSize="14.5" FontAttributes="Bold"
                                               TextColor="{StaticResource Ink}"/>
                                        <Label Text="{Binding Relationship}"
                                               FontSize="11.5"
                                               TextColor="{StaticResource Muted}"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="›" FontSize="18"
                                           TextColor="{StaticResource Faint}"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Kontakt qo'shish -->
                    <BoxView Color="{StaticResource Line}" HeightRequest="1"/>
                    <Grid ColumnDefinitions="Auto,*" Padding="16,14">
                        <Border Grid.Column="0"
                                WidthRequest="36" HeightRequest="36"
                                BackgroundColor="{StaticResource CardAlt}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 18"
                                Margin="0,0,12,0">
                            <Label Text="＋" FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource Navy2}"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Column="1" Text="Kontakt qo'shish"
                               FontSize="14.5" FontAttributes="Bold"
                               TextColor="{StaticResource Navy2}"
                               VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddContactCommand}"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ─── SOZLAMALAR ────────────────────────────────────── -->
            <Label Text="SOZLAMALAR"
                   FontSize="11" FontAttributes="Bold"
                   TextColor="{StaticResource Muted}"
                   CharacterSpacing="1.4"
                   Margin="40,18,24,8"/>

            <Border Margin="16,0"
                    BackgroundColor="{StaticResource Card}"
                    StrokeThickness="1" Stroke="{StaticResource Line}"
                    StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="0">

                    <!-- Tibbiy ma'lumotlar -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="18,14">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditMedicalCommand}"/>
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                WidthRequest="36" HeightRequest="36"
                                BackgroundColor="{StaticResource CardAlt}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Margin="0,0,14,0">
                            <Label Text="❤️" FontSize="19"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="Tibbiy ma'lumotlar"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource Ink}"/>
                            <Label Text="Qon guruhi, allergiyalar"
                                   FontSize="12.5"
                                   TextColor="{StaticResource Muted}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="18"
                               TextColor="{StaticResource Faint}"
                               VerticalOptions="Center"/>
                    </Grid>
                    <BoxView Color="{StaticResource Line}" HeightRequest="1"/>

                    <!-- Ogohlantirish ovozi -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="18,14">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleAlertSoundCommand}"/>
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                WidthRequest="36" HeightRequest="36"
                                BackgroundColor="{StaticResource CardAlt}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Margin="0,0,14,0">
                            <Label Text="🔔" FontSize="19"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Column="1"
                               Text="Ogohlantirish ovozi"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource Ink}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2"
                               Text="{Binding AlertSoundText}"
                               FontSize="13.5" TextColor="{StaticResource Muted}"
                               VerticalOptions="Center"
                               Margin="0,0,8,0"/>
                        <Label Grid.Column="3" Text="›" FontSize="18"
                               TextColor="{StaticResource Faint}"
                               VerticalOptions="Center"/>
                    </Grid>
                    <BoxView Color="{StaticResource Line}" HeightRequest="1"/>

                    <!-- Til -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="18,14">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeLanguageCommand}"/>
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                WidthRequest="36" HeightRequest="36"
                                BackgroundColor="{StaticResource CardAlt}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Margin="0,0,14,0">
                            <Label Text="🌐" FontSize="19"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Column="1"
                               Text="Til"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource Ink}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2"
                               Text="{Binding Language}"
                               FontSize="13.5" TextColor="{StaticResource Muted}"
                               VerticalOptions="Center"
                               Margin="0,0,8,0"/>
                        <Label Grid.Column="3" Text="›" FontSize="18"
                               TextColor="{StaticResource Faint}"
                               VerticalOptions="Center"/>
                    </Grid>
                    <BoxView Color="{StaticResource Line}" HeightRequest="1"/>

                    <!-- Hujjatlar -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="18,14">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenDocumentsCommand}"/>
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                WidthRequest="36" HeightRequest="36"
                                BackgroundColor="{StaticResource CardAlt}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Margin="0,0,14,0">
                            <Label Text="📄" FontSize="19"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Column="1"
                               Text="Hujjat va arizalar"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource Ink}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="›" FontSize="18"
                               TextColor="{StaticResource Faint}"
                               VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
