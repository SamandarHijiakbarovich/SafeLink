<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SafeLink.ViewModels.Onboarding"
    x:Class="SafeLink.Views.Onboarding.OrderPage"
    x:DataType="vm:OrderViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource BgMain}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="0">

            <!-- Progress -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,56,0,0">
                <BoxView WidthRequest="22" HeightRequest="6" CornerRadius="3" Color="{StaticResource Navy}"/>
                <BoxView WidthRequest="22" HeightRequest="6" CornerRadius="3" Color="{StaticResource Navy}"/>
                <BoxView WidthRequest="22" HeightRequest="6" CornerRadius="3" Color="{StaticResource Navy}"/>
                <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="{StaticResource Line2}"/>
                <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="{StaticResource Line2}"/>
            </HorizontalStackLayout>

            <Label Text="Himoya orderi"
                   FontSize="26" FontAttributes="Bold"
                   TextColor="{StaticResource Ink}" CharacterSpacing="-0.4"
                   Margin="0,32,0,0"/>
            <Label Text="Sudning yoki Ichki Ishlar bo'limining qarorini yuklang."
                   FontSize="14" TextColor="{StaticResource Muted}"
                   LineHeight="1.5" Margin="0,10,0,0"/>

            <!-- Fayl yuklash kartasi -->
            <Border BackgroundColor="{StaticResource Card}"
                    StrokeThickness="1" Stroke="{StaticResource Line}"
                    StrokeShape="RoundRectangle 20"
                    Padding="16" Margin="0,22,0,0">
                <Grid ColumnDefinitions="80,*" ColumnSpacing="14">
                    <!-- Doc thumbnail -->
                    <Border Grid.Column="0"
                            BackgroundColor="{StaticResource CardAlt}"
                            StrokeThickness="1" Stroke="{StaticResource Line}"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="80" HeightRequest="108">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                            <Label Text="📄" FontSize="32" HorizontalOptions="Center"/>
                            <Label Text="PDF" FontSize="10" FontAttributes="Bold"
                                   TextColor="{StaticResource Muted}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <!-- Yuklangan holda -->
                        <Border IsVisible="{Binding HasFile}"
                                BackgroundColor="{StaticResource GreenSoft}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                Padding="8,4" HorizontalOptions="Start">
                            <Label Text="YUKLANDI" FontSize="10" FontAttributes="Bold"
                                   TextColor="{StaticResource Green}"/>
                        </Border>

                        <Label Text="Himoya orderi" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource Ink}"/>
                        <Label Text="{Binding OrderNumber, StringFormat='№ {0}'}"
                               IsVisible="{Binding HasFile}"
                               FontSize="12" TextColor="{StaticResource Muted}"/>
                        <Label Text="Faylni tanlash uchun bosing"
                               IsVisible="{Binding HasFile, Converter={StaticResource NotHasFile}}"
                               FontSize="12" TextColor="{StaticResource Muted}"
                               LineHeight="1.4"/>

                        <Button Text="Fayl tanlash"
                                Command="{Binding PickFileCommand}"
                                BackgroundColor="{StaticResource Navy}"
                                TextColor="White" FontSize="12" FontAttributes="Bold"
                                HeightRequest="34" CornerRadius="8"
                                HorizontalOptions="Start" Padding="12,0"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Ogohlantirish: hujjat bo'lmasa -->
            <Border BackgroundColor="#14D97706"
                    StrokeThickness="1" Stroke="#33D97706"
                    StrokeShape="RoundRectangle 12"
                    Padding="14" Margin="0,14,0,0">
                <HorizontalStackLayout Spacing="10">
                    <Border BackgroundColor="{StaticResource Amber}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 6"
                            WidthRequest="24" HeightRequest="24" VerticalOptions="Start">
                        <Label Text="!" FontSize="13" FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Fill">
                        <Label Text="Hujjat hozircha bo'lmasa"
                               FontSize="12.5" FontAttributes="Bold"
                               TextColor="#92400E"/>
                        <Label Text="IIB ga arizangiz bilan bevosita ariza topshirish mumkin."
                               FontSize="11.5" TextColor="#78350F" LineHeight="1.45"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <Button Text="Davom etish"
                    Command="{Binding ContinueCommand}"
                    BackgroundColor="{StaticResource Navy}"
                    TextColor="White" FontAttributes="Bold" FontSize="15"
                    HeightRequest="56" CornerRadius="16"
                    Margin="0,32,0,0"/>

            <Button Text="Hujjatsiz davom etish"
                    Command="{Binding SkipCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Navy2}"
                    FontSize="14" FontAttributes="Bold"
                    HeightRequest="48" BorderWidth="0"
                    Margin="0,8,0,40"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
