<?xml version="1.0" encoding="utf-8" ?>
<!--
    BRELOKNI ULASH EKRANI
    =======================
    Bluetooth LE orqali SafeLink SL-100 brelokni ulash.
    3 qadam: 1) Qidirish → 2) Topildi → 3) Ulandi
-->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SafeLink.Views.PairingPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource BgMain}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Padding="24,56,24,0">
            <Border Grid.Column="0"
                    BackgroundColor="{StaticResource Card}"
                    StrokeThickness="1" Stroke="{StaticResource Line}"
                    StrokeShape="RoundRectangle 11"
                    WidthRequest="38" HeightRequest="38">
                <Label Text="‹" FontSize="22" TextColor="{StaticResource Ink}"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1"
                   Text="1 / 3 qadam"
                   FontSize="13" FontAttributes="Bold"
                   TextColor="{StaticResource Muted}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   CharacterSpacing="0.4"/>
        </Grid>

        <!-- Kontent -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0">

                <!-- Brelok illustration -->
                <Border Margin="16,18,16,0"
                        HeightRequest="280"
                        BackgroundColor="{StaticResource Navy2}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24">
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8">
                        <!-- Radar halqalar (animatsion) -->
                        <Grid WidthRequest="200" HeightRequest="200"
                              HorizontalOptions="Center">
                            <Ellipse x:Name="Radar1"
                                     WidthRequest="180" HeightRequest="180"
                                     Stroke="#1EFFFFFF" StrokeThickness="1"
                                     Fill="Transparent"/>
                            <Ellipse x:Name="Radar2"
                                     WidthRequest="140" HeightRequest="140"
                                     Stroke="#1EFFFFFF" StrokeThickness="1"
                                     Fill="Transparent"/>
                            <!-- Brelok emoji (keyinroq SVG bilan almashtirish) -->
                            <Label Text="🔑"
                                   FontSize="72"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Matn -->
                <VerticalStackLayout Padding="24,24,24,0"
                                     HorizontalOptions="Center"
                                     Spacing="8">
                    <Label Text="Brelokni telefoningizga ulang"
                           FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource Ink}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           CharacterSpacing="-0.3"/>
                    <Label Text="Brelok tugmasini 5 soniya bosib turing. Ko'k chiroq miltillaganda qurilma topiladi."
                           FontSize="14" TextColor="{StaticResource Muted}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineHeight="1.5"/>
                </VerticalStackLayout>

                <!-- Topilgan qurilma kartasi -->
                <Border Margin="16,20,16,0"
                        BackgroundColor="{StaticResource Card}"
                        StrokeThickness="1" Stroke="{StaticResource Line}"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0"
                                WidthRequest="38" HeightRequest="38"
                                BackgroundColor="#1A2563EB"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Margin="0,0,14,0">
                            <Label Text="🔵" FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="SafeLink SL-100"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource Ink}"/>
                            <Label Text="Topildi · 0.3 m · signal kuchli"
                                   FontSize="12" TextColor="{StaticResource Muted}"/>
                        </VerticalStackLayout>
                        <!-- Signal bars -->
                        <HorizontalStackLayout Grid.Column="2"
                                               Spacing="3"
                                               VerticalOptions="Center">
                            <BoxView Color="{StaticResource Green}"
                                     WidthRequest="4" HeightRequest="14" CornerRadius="2"/>
                            <BoxView Color="{StaticResource Green}"
                                     WidthRequest="4" HeightRequest="18" CornerRadius="2"/>
                            <BoxView Color="{StaticResource Green}"
                                     WidthRequest="4" HeightRequest="22" CornerRadius="2"/>
                            <BoxView Color="{StaticResource Green}"
                                     WidthRequest="4" HeightRequest="26" CornerRadius="2"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Ulash tugmasi -->
        <Button Grid.Row="2"
                Text="Qurilmani ulash"
                BackgroundColor="{StaticResource Navy}"
                TextColor="White"
                CornerRadius="16"
                HeightRequest="56"
                FontSize="15"
                FontAttributes="Bold"
                Margin="16,0,16,48"/>

    </Grid>
</ContentPage>
