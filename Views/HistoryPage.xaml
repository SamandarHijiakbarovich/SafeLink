<?xml version="1.0" encoding="utf-8" ?>
<!--
    TARIX SAHIFASI
    ================
    O'tgan SOS signallar tarixi.
    Hozircha oddiy versiya — keyinroq kengaytiriladi.
-->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SafeLink.Views.HistoryPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource BgMain}">

    <VerticalStackLayout HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Spacing="16">
        <Label Text="🕐"
               FontSize="64"
               HorizontalOptions="Center"/>
        <Label Text="Tarix"
               FontSize="22" FontAttributes="Bold"
               TextColor="{StaticResource Ink}"
               HorizontalOptions="Center"/>
        <Label Text="Signal tarixi bu yerda ko'rinadi"
               FontSize="15" TextColor="{StaticResource Muted}"
               HorizontalOptions="Center"/>
    </VerticalStackLayout>

</ContentPage>
