# Build natijalari
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# APK va boshqa kompilyatsiya natijalari
*.apk
*.aab
*.ipa
*.app
*.dll
*.exe
*.pdb

# Visual Studio
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Rider / JetBrains
.idea/

# NuGet paketlar
packages/
*.nupkg
*.snupkg
.nuget/

# MSBuild
*.binlog

# Android
local.properties
*.keystore
!debug.keystore

# iOS
*.xcuserstate
DerivedData/

# Test natijalari
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
coverage*.json
coverage*.xml

# Boshqa
*.tmp
*.cache
*.bak
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Maxfiy ma'lumotlar
*.env
appsettings.Development.json
secrets.json

# Dev SQLite ma'lumotlar bazasi
*.db
*.db-shm
*.db-wal
