<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- SafeLink Dispatch (IIV) — ops palitra -->
    <Color x:Key="Navy">#0A2540</Color>
    <Color x:Key="Navy2">#13325F</Color>
    <Color x:Key="Navy3">#1F4480</Color>

    <Color x:Key="BgMain">#F5F7FB</Color>
    <Color x:Key="Card">#FFFFFF</Color>
    <Color x:Key="CardAlt">#F0F3F9</Color>
    <Color x:Key="OpsDark">#0F1419</Color>

    <Color x:Key="Ink">#0A2540</Color>
    <Color x:Key="Ink2">#334155</Color>
    <Color x:Key="Muted">#64748B</Color>
    <Color x:Key="Faint">#94A3B8</Color>

    <Color x:Key="Line">#E5E9F0</Color>
    <Color x:Key="Line2">#CBD5E1</Color>

    <Color x:Key="Red">#E11D48</Color>
    <Color x:Key="RedDeep">#9F1239</Color>
    <Color x:Key="RedSoft">#FEE2E7</Color>
    <Color x:Key="Green">#16A34A</Color>
    <Color x:Key="GreenSoft">#DCFCE7</Color>
    <Color x:Key="Amber">#D97706</Color>
    <Color x:Key="AmberSoft">#FEF3C7</Color>
    <Color x:Key="Blue">#2563EB</Color>
    <Color x:Key="BlueSoft">#DBEAFE</Color>
    <Color x:Key="Gold">#FBBF24</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <!-- MAUI default Styles.xaml uchun kerakli kalitlar -->
    <Color x:Key="Primary">#0A2540</Color>
    <Color x:Key="PrimaryDark">#1F4480</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#13325F</Color>
    <Color x:Key="SecondaryDarkText">#FFFFFF</Color>
    <Color x:Key="Tertiary">#2563EB</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource Navy}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Card}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>

</ResourceDictionary>
